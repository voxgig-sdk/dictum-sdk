# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: true
      sh: "The author of the quote"
      t: "`$STRING`"
    }
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Category or theme of the quote"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier of the quote"
      t: "`$STRING`"
    }
    source: {
      h: "Source"
      n: "source"
      r: false
      sh: "Source or origin of the quote"
      t: "`$STRING`"
    }
    text: {
      h: "Text"
      n: "text"
      r: true
      sh: "The text content of the quote"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /quotes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "author"
                or: "author"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "category"
                or: "category"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/quotes"
          q: {
            exist: [
              "author"
              "category"
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "quotes"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.quotes`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /quotes/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/quotes/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "quotes"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /quotes/random"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/quotes/random"
          q: {
            "$action": "random"
          }
          s: [
            {
              lit: "quotes"
            }
            {
              lit: "random"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
